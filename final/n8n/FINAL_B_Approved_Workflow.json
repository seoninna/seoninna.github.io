      "id": "c389b87a-3aa7-515c-a6de-ebada7b88a89",
      "name": "11 B compare service",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        100
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ctx = $('07 Lookup pair in manifest').item.json;\nconst r = $json;\nconst ok = r.ok === true;\nconst n = r.notification || {};\nconst subject = ok ? `FINALRESULT | ${ctx.category_code} | ${ctx.artwork_id} | ${r.summary.overall_status}`\n                   : `FINALRESULT | ${ctx.category_code} | ${ctx.artwork_id} | NOT_COMPARED ${r.error_code || ''}`;\nconst html = ok ? (n.html + '<p>첨부 HTML 보고서를 브라우저로 여세요. 최종 승인이 아닙니다.</p>')\n                : `<p>비교하지 못했습니다: ${r.error_code || 'UNKNOWN'}. 결과를 '변경 없음'으로 해석하지 마세요.</p>`;\nconst fallback = Buffer.from(`<!doctype html><meta charset=\"utf-8\"><p>NOT_COMPARED: ${r.error_code || 'UNKNOWN'}</p>`).toString('base64');\nreturn { json: { ...ctx, subject, html, compare_ok: ok, overall_status: r.summary?.overall_status || null,\n  summary: r.summary || null, compare_error: r.error_code || null },\n  binary: { audit_report: { data: (ok && r.report_html_b64) ? r.report_html_b64 : fallback, mimeType: 'text/html',\n  fileName: `FINAL_${ctx.category_code}_${ctx.artwork_id}.html` } } };\n"
      },
