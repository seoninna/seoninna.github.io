        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "c5b7c966-a11e-5eb3-9711-199c4561b833",
