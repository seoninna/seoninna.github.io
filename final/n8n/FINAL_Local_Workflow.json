        660,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('02 Settings').first().json.api_base }}/compare",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ pair_id: $json.pair_id, event_id: $json.event_id }) }}",
        "options": {
          "timeout": 3600000
        }
      },
      "id": "85cf59c3-e07a-5588-8169-a5fb47541f38",
      "name": "05 Compare pair (local API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "a89a56c1-2784-535b-b89b-6b459eee327e",
              "leftValue": "={{ $json.ok === true && $json.status === 'COMPARED' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1ab245be-357a-5c1a-8151-36ef85f76d04",
      "name": "06 Compared?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1c49c34-9230-57b0-8cc0-a272d93ad04a",
              "leftValue": "={{ $json.safe_email_enabled === true && $('02 Settings').first().json.safe_notice_to !== '' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f9580112-6837-592d-9385-0db0474d9097",
      "name": "07 Safe notice approved?",
